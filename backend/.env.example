# Port the API listens on. Defaults to 8000 when unset. Only set this if 8000
# is already taken on your machine — and set VITE_API_URL in the project-root
# .env to the same port so the frontend knows where to look.
#API_PORT=8010

DEEPSEEK_API_KEY=your-deepseek-api-key-here
JWT_SECRET=generate-a-random-secret-e.g-python-c-import-secrets-print-secrets-token-hex-32
GOOGLE_WEATHER_API_KEY=your-google-maps-platform-api-key-with-weather-api-enabled
ORS_API_KEY=