# Frontend config (Vite). Copy to .env and edit if you need to change it.
#
# Backend base URL. Leave unset to use the default http://127.0.0.1:8000.
# Set this only if port 8000 is already taken by another project on your
# machine — then start the backend on the matching port, e.g.
#   cd backend && .venv\Scripts\python.exe -m uvicorn main:app --port 8010
#VITE_API_URL=http://127.0.0.1:8010
